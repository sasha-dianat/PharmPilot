FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    build-essential \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxrender1 \
    libxext6 \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml .
RUN pip install poetry && \
    poetry config virtualenvs.create false && \
    poetry install --no-dev --no-interaction

# FAISS and ArcFace models expected at /app/models/
# Mount as volume in production — do not bake into image

COPY . .

ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
